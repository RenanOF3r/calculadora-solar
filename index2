<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Calculadora Solar</title>
  <link rel="stylesheet" href="styles.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels"></script>
</head>
<body>
  <h1>Calculadora Solar</h1>
  <div class="container">
    <div class="input-group">
      <label for="cidade">Cidade</label>
      <select id="cidade" disabled>
        <option value="4.55" selected>Rio de Janeiro (RJ)</option>
      </select>
    </div>
    
    <div class="input-group">
      <label for="consumo">Consumo médio mensal (kWh)</label>
      <input type="number" id="consumo" placeholder="Digite seu consumo mensal">
      <span class="error-message" id="erro-consumo">Por favor, insira um valor válido.</span>
    </div>
    
    <div class="input-group">
      <label for="tarifa">Tarifa de Energia (R$/kWh)</label>
      <input type="number" id="tarifa" placeholder="Digite a tarifa de energia">
      <span class="error-message" id="erro-tarifa">Por favor, insira um valor válido.</span>
    </div>
    
    <button onclick="calcular()">Calcular</button>
  </div>
  
  <canvas id="graficoConsumoGeracao"></canvas>
  <canvas id="graficoEconomiaMensal"></canvas>

  <script src="script.js"></script>
</body>
</html>
